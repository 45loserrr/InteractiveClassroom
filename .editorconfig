# 统一编辑器行为：避免 6 人各用各的缩进、换行、编码导致的无意义 diff
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 140

[*.{xml,yml,yaml,json,jsonc,properties}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{cmd,bat}]
end_of_line = crlf

[*.{ps1,sh}]
indent_size = 4

[*.sql]
indent_size = 4

[Makefile]
indent_style = tab
